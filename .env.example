# Copy to .env and fill in. NEVER commit .env.
AWS_REGION=us-east-1

# SECURITY — span redaction. Do not change this line.
#
# Strands redacts sensitive span attributes ONLY when an allowlist token is
# present. The token's VALUE lists what to leave UNREDACTED, so the empty value
# below means "redact everything sensitive". Deleting the trailing "=" silently
# disables redaction entirely and exports every prompt, tool argument, and tool
# result — the full household record — to CloudWatch. The trailing "=" is
# load-bearing. Verified against strands-agents 1.54.0; see Appendix E.1.
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental,gen_ai_unredacted_attributes=

# Groups Grace's spans in the CloudWatch GenAI Observability dashboard.
# Default is "strands-agents", indistinguishable from any other Strands app.
OTEL_SERVICE_NAME=grace

# Set after `agentcore add memory` (Plan 2)
BEDROCK_AGENTCORE_MEMORY_ID=

# Set after creating a Bedrock guardrail (Plan 2). Pin a numeric version,
# not DRAFT, in anything user-facing.
GRACE_GUARDRAIL_ID=
GRACE_GUARDRAIL_VERSION=

# SMS origination (Plan 2). Account is sandboxed: destinations must be
# verified and the monthly spend cap is ~$1. The transcript channel is the
# always-works path; the demo must not depend on SMS delivery.
GRACE_SMS_ORIGINATION_NUMBER=
