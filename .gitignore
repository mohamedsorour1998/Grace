# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# Secrets — never commit
.env
.env.*
!.env.example
config.json
*.pem
*.key
credentials

# AgentCore local state
.bedrock_agentcore.yaml
# `agentcore/` itself IS committed — it is deployment state (the CDK app and
# agentcore.json, which carries the execution role ARN and the redaction token),
# not a build artifact. Only the generated and secret parts are ignored.
agentcore/cdk/node_modules/
agentcore/cdk/cdk.out/
agentcore/.env.local
agentcore/.cli/*
!agentcore/.cli/deployed-state.json
agentcore/.cache/

# Eval output
eval/results/
evals/results/
offloaded/
sessions/

# OS / editor
.DS_Store
.idea/
*.swp
